# Public values from Sender > Forms > Publishing settings / integration snippet.
# Account ID: the quoted PUBLIC ID in sender('...'), never an API access token.
# Form ID: the value in data-sender-form-id="...".
# Form URL: https://stats.sender.net/forms/<same-form-id>/view
# Leave blank until email-only fields, consent, CAPTCHA and double opt-in are checked.
# Missing/invalid/mismatched values keep signup closed. No API key is required.
SENDER_PUBLIC_ACCOUNT_ID=
SENDER_NEWSLETTER_FORM_ID=
SENDER_NEWSLETTER_FORM_URL=

# Optional popup: leave disabled until Denny approves its Sender settings and release.
# Use the POPUP form's ID from the same account, not the embedded form's ID.
# Sender must publish it and configure its delay, frequency and visibility separately.
SENDER_NEWSLETTER_POPUP_ENABLED=false
SENDER_NEWSLETTER_POPUP_FORM_ID=
